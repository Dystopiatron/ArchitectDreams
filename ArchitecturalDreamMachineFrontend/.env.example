# Architectural Dream Machine - Environment Configuration
# Copy this file to .env and modify as needed

# API Base URL
# Default: http://localhost:5095
# 
# For physical device testing, use your machine's IP address:
# Example: REACT_NATIVE_API_URL=http://192.168.1.100:5095
#
# For production, use your production API URL:
# Example: REACT_NATIVE_API_URL=https://api.yourdomain.com

REACT_NATIVE_API_URL=http://localhost:5095
